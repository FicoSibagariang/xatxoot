# ==============================================================================
# Xatxoot Production Environment Variables (.env.production.example)
# Single Organization On-Premise & Cloud Self-Host Deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Public Domain Routing
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_URL=https://chat.example.com
API_URL=https://chat.example.com/api/v1
CADDY_DOMAIN=chat.example.com
CADDY_EMAIL=admin@example.com

# Internal Container Ports
PORT_API=3000
PORT_GATEWAY=3001
PORT_WEB=80

# ------------------------------------------------------------------------------
# 2. Database & Cache Connections
# ------------------------------------------------------------------------------
# PostgreSQL 16 with pgvector extension enabled
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://xatxoot_prod:replace_with_strong_password@postgres:5432/xatxoot_prod

# Redis Pub/Sub & BullMQ queue backend
# Format: redis://[:password@]<host>:<port>
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 3. Security, Authentication & Session Tokens
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_random_64_character_base64_jwt_secret
REFRESH_TOKEN_SECRET=replace_with_random_64_character_base64_refresh_secret
SESSION_SECRET=replace_with_random_64_character_base64_session_secret

# Secret key for encrypting API keys & credentials in database
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_random_32_byte_hex_encryption_key

# ------------------------------------------------------------------------------
# 4. WhatsApp Cloud API (Official Meta Graph API v18.0+)
# ------------------------------------------------------------------------------
WHATSAPP_CLOUD_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_CLOUD_ACCESS_TOKEN=replace_with_system_user_access_token
WHATSAPP_CLOUD_PHONE_NUMBER_ID=replace_with_phone_number_id
WHATSAPP_CLOUD_WABA_ID=replace_with_waba_id
WHATSAPP_CLOUD_APP_SECRET=replace_with_meta_app_secret
WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN=replace_with_random_webhook_token

# ------------------------------------------------------------------------------
# 5. WhatsApp Unofficial Gateway (Baileys Multi-Device Socket)
# ------------------------------------------------------------------------------
WA_GATEWAY_REDIS_PREFIX=xatxoot:wa:
WA_GATEWAY_RECONNECT_INTERVAL=5000
WA_GATEWAY_SESSION_PATH=/data/baileys_auth
WA_GATEWAY_QR_EXPIRY_SECONDS=60

# ------------------------------------------------------------------------------
# 6. Authentication: Google OAuth SSO
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=replace_with_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_CALLBACK_URL=https://chat.example.com/api/v1/auth/google/callback
# Restrict sign-in to company domain (comma-separated, leave blank to disable restriction)
GOOGLE_ALLOWED_DOMAINS=example.com,company.org

# ------------------------------------------------------------------------------
# 7. Enterprise SSO (SAML 2.0 & OIDC) Metadata Endpoints
# ------------------------------------------------------------------------------
# SAML Service Provider Entity ID: https://chat.example.com/api/v1/sso/saml/metadata
# SAML ACS (Assertion Consumer Service): https://chat.example.com/api/v1/sso/saml/acs
# OIDC Redirect Callback: https://chat.example.com/api/v1/sso/oidc/callback

# ------------------------------------------------------------------------------
# 8. AI Copilot & Knowledge Base Semantic Search (Bring-Your-Own-Key)
# ------------------------------------------------------------------------------
# OpenAI (Default for text summarization, tone adjustment & text-embedding-3-small)
OPENAI_API_KEY=sk-replace_with_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local Ollama (Optional self-hosted model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 9. Omnichannel: Email (SMTP & IMAP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@example.com
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM_NAME=Xatxoot Customer Support
SMTP_FROM_EMAIL=support@example.com

IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=support@example.com
IMAP_PASSWORD=replace_with_imap_password

# ------------------------------------------------------------------------------
# 10. Omnichannel: Telegram Bot
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_WEBHOOK_URL=https://chat.example.com/api/v1/webhooks/telegram

# ------------------------------------------------------------------------------
# 11. Omnichannel: Twilio SMS
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=replace_with_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 12. Omnichannel: Meta Social (Facebook Messenger & Instagram Direct)
# ------------------------------------------------------------------------------
META_APP_ID=replace_with_meta_app_id
META_APP_SECRET=replace_with_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=replace_with_meta_webhook_verify_token
