{
  "name": "xatxoot",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --env-file=.env --filter '*' dev",
    "build": "bun --filter '*' build",
    "test": "bun test",
    "test:unit": "bun test packages/shared apps/wa-gateway apps/wa-simulator",
    "test:integration": "bun test apps/api",
    "test:e2e": "bun test test/e2e-smoke-flow.test.ts",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun --filter '@xatxoot/api' db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "bun-types": "^1.4.4",
    "typescript": "^5"
  }
}
