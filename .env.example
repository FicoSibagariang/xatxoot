# PostgreSQL (Port 5432)
DATABASE_URL=postgresql://xatxoot:xatxoot_secret@localhost:5432/xatxoot_dev

# Redis (Port 6379)
REDIS_URL=redis://localhost:6379

# Server Host & Ports
HOST=0.0.0.0
PORT_API=3000
PORT_GATEWAY=3001
PORT_SIMULATOR=3002
PORT_WEB=5173

# Autentikasi & Keamanan (Argon2id & JWT Session)
JWT_SECRET=super_secret_jwt_key_xatxoot_dev_only
REFRESH_TOKEN_SECRET=super_secret_refresh_key_xatxoot_dev_only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=example.com,company.org

# Meta WhatsApp Cloud API (Opsional di Fase 0/1)
WHATSAPP_CLOUD_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN=xatxoot_verify_token

# WhatsApp Gateway Raw Messages Dump (Aktif default: true, retensi: 14 hari)
WA_GATEWAY_DUMP_MESSAGES=true
WA_GATEWAY_DUMP_RETENTION_DAYS=14
WA_SESSION_ENCRYPTION_KEY=xatxoot_dev_session_secret_32bytes

# Object Storage: S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=xatxoot-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=
